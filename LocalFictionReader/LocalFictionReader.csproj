<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A3B46958-3E3F-4F1D-887D-42E34A07B612}</ProjectGuid>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <GenerateAppxPackage>true</GenerateAppxPackage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EnableDotNetNativeCompatibleProfile>true</EnableDotNetNativeCompatibleProfile>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Platforms>x86;x64;ARM</Platforms>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RuntimeIdentifiers>win10-x86;win10-x64;win10-arm</RuntimeIdentifiers>
  </PropertyGroup>
  <!--
    原工程没有任何 Configuration|Platform 的 PropertyGroup，MSBuild 因此拿不到
    OutputPath，直接报 "The BaseOutputPath/OutputPath property is not set"。
    这里补齐标准 UWP 模板的属性组。
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x86' ">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x64' ">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'ARM' ">
    <PlatformTarget>ARM</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\x86\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\x86\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|ARM' ">
    <OutputPath>bin\ARM\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|ARM' ">
    <OutputPath>bin\ARM\Release\</OutputPath>
  </PropertyGroup>
  <!--
    UWP 的 XAML targets 目录按 VS 版本号命名（VS2022 = v17.0），
    老模板里写的 v10.0.19041.0（按 TargetPlatformVersion）在 VS2017 之后就不存在了，
    会直接报 MSB4226。这里按“VisualStudioVersion → v17.0 → TargetPlatformVersion”的顺序探测。
  -->
  <PropertyGroup>
    <WindowsXamlTargetsRoot>$(MSBuildExtensionsPath)\Microsoft\WindowsXaml</WindowsXamlTargetsRoot>
    <WindowsXamlTargetsVersion Condition="Exists('$(WindowsXamlTargetsRoot)\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets')">v$(VisualStudioVersion)</WindowsXamlTargetsVersion>
    <WindowsXamlTargetsVersion Condition="'$(WindowsXamlTargetsVersion)' == '' and Exists('$(WindowsXamlTargetsRoot)\v17.0\Microsoft.Windows.UI.Xaml.CSharp.targets')">v17.0</WindowsXamlTargetsVersion>
    <WindowsXamlTargetsVersion Condition="'$(WindowsXamlTargetsVersion)' == ''">v$(TargetPlatformVersion)</WindowsXamlTargetsVersion>
  </PropertyGroup>
  <Import Project="$(WindowsXamlTargetsRoot)\$(WindowsXamlTargetsVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>7.0.3</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Toolkit.Mvvm">
      <Version>7.1.2</Version>
    </PackageReference>
    <!-- 说明：原来的 Microsoft.NETCore.Platforms / Microsoft.NETCore.Targets 是 NuGet 2.x 时代的
         RID 选择辅助包，UWP 工程里会把 netcore 的 System.Runtime 门面扯进来，导致 XAML 编译器报
         WMC1006 "Type universe cannot resolve assembly: System.Runtime, Version=4.0.0.0"，已移除。
         另外 Microsoft.UI.Xaml（WinUI 2）本项目代码从未使用，一并移除以免增加还原/解析风险。 -->
    <!-- UWP/CoreCLR 默认只注册 UTF-8/UTF-16 等少量编码，缺少 GBK(936)。不引入本包并注册 provider，
         BookParserService 的 GBK 回退会抛异常，中文 txt 仍然乱码。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="4.7.1" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainPage.xaml.cs">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Models\Book.cs" />
    <Compile Include="Models\Chapter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\BookParserService.cs" />
    <Compile Include="ViewModels\MainViewModel.cs" />
  </ItemGroup>
</Project>
