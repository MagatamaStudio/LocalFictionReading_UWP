<Page
    x:Class="LocalFictionReader.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalFictionReader"
    xmlns:vm="using:LocalFictionReader.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0">
            <AppBarButton Icon="OpenFile" Label="打开文件" Command="{x:Bind ViewModel.OpenFileCommand}"/>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="BooksList" ItemsSource="{x:Bind ViewModel.Books}" DisplayMemberPath="Title"
                      SelectedItem="{x:Bind ViewModel.SelectedBook, Mode=TwoWay}"
                      SelectionMode="Single" Grid.Column="0"/>

            <ListView ItemsSource="{x:Bind ViewModel.SelectedBook.Chapters, Mode=OneWay}" DisplayMemberPath="Title"
                      SelectionMode="Single" Grid.Column="1" Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Page>
